{
  "name": "ftscr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint src tests",
    "generate": "node dist/cli.js generate --input fixtures/source.json",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "description": "Generate Paris 2024 football reference JSON from the official Olympic API.",
  "repository": {
    "type": "git",
    "url": "https://github.com/paul-orzechowski/ftscr.git"
  }
}
